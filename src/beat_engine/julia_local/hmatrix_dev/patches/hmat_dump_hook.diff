 module BeatEngineCoupledCondensed
 
 using LinearAlgebra, SparseArrays, StaticArrays, Statistics
+const _HMAT_DUMP = Ref{Any}(nothing)   # BLAB_HMAT_DUMP development hook (no extra package dependencies)
+# Raw dump: one .bin per array, manifest.txt lines "name kind eltype dims..." (kind: array, sparse, scalar, text).
+function _hmat_save(dir::AbstractString, data::NamedTuple)
+    mkpath(dir)
+    open(joinpath(dir, "manifest.txt"), "w") do man
+        rawarr(name, a) = (write(joinpath(dir, name * ".bin"), a); println(man, name, " array ", eltype(a), " ", join(size(a), " ")))
+        for (key, value) in pairs(data)
+            name = String(key)
+            if value isa SparseMatrixCSC
+                I, J, V = findnz(value)
+                rawarr(name * "__I", I); rawarr(name * "__J", J); rawarr(name * "__V", ComplexF64.(V))
+                println(man, name, " sparse ", size(value, 1), " ", size(value, 2))
+            elseif value isa AbstractRange
+                println(man, name, " range ", first(value), " ", last(value))
+            elseif value isa AbstractArray{<:Number}
+                rawarr(name, collect(value))
+            elseif value isa BoundaryMesh
+                rawarr(name * "__vertices", reduce(hcat, [Float64.(collect(v)) for v in value.vertices]))
+                rawarr(name * "__faces", reduce(hcat, [collect(f) for f in value.faces]))
+                rawarr(name * "__tags", collect(value.physical_tags))
+                println(man, name, " mesh")
+            elseif value === nothing
+                println(man, name, " nothing")
+            elseif value isa Number
+                println(man, name, " scalar ", typeof(value), " ", value)
+            else
+                println(man, name, " text ", string(value))
+            end
+        end
+    end
+end
